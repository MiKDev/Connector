{
  "name": "connector-desktop",
  "productName": "Connector",
  "version": "0.8.0",
  "description": "Local SSH workspace with multi-exec and approval-based AI tools",
  "author": "Connector contributors",
  "license": "MIT",
  "homepage": "https://github.com/MiKDev/Connector",
  "repository": { "type": "git", "url": "https://github.com/MiKDev/Connector.git" },
  "bugs": { "url": "https://github.com/MiKDev/Connector/issues" },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/core.test.cjs tests/ssh.test.cjs tests/files.test.cjs tests/network.test.cjs tests/team.test.cjs tests/forwards.test.cjs tests/diagnostics.test.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "test:team-desktop": "node tests/team-desktop.cjs",
    "pack:win": "npm run build && electron-builder --win nsis zip --x64",
    "pack:linux": "npm run build && electron-builder --linux AppImage deb --x64 --config scripts/linux-builder.cjs",
    "test:gateway": "node tests/gateway-live.cjs",
    "build:gateway": "node scripts/gateway-build.cjs",
    "prepare:gateway": "node scripts/gateway-download.cjs && node scripts/gateway-extract.cjs && node scripts/gateway-packages.cjs && node scripts/gateway-build.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/xterm": "^5.5.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.13.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "dev.connector.desktop",
    "asar": true,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "src/distro-icons/LICENSE.md",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Connector-${version}-windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "artifactName": "Connector-${version}-linux-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "vpn-runtime",
        "to": "vpn-runtime",
        "filter": [
          "images/**/*",
          "manifest.json",
          "packages.json",
          "qemu/qemu-system-x86_64.exe",
          "qemu/*.dll",
          "qemu/COPYING*",
          "qemu/README.rst",
          "qemu/VERSION",
          "qemu/share/bios*.bin",
          "qemu/share/kvmvapic.bin",
          "qemu/share/linuxboot*.bin",
          "qemu/share/multiboot*.bin",
          "qemu/share/pvh.bin",
          "qemu/share/*virtio*.rom",
          "qemu/share/vgabios*.bin",
          "qemu/share/doc/**/COPYING*",
          "qemu/share/doc/**/LICENSE*",
          "qemu/share/doc/**/LICENCE*",
          "qemu/share/doc/**/copyright*",
          "qemu/share/doc/**/license*"
        ]
      }
    ]
  }
}
